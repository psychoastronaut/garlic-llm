{
  "openapi": "3.1.0",
  "info": {
    "title": "Garlic LLM API",
    "version": "1.20",
    "summary": "OpenAI-compatible chat API for Garlic LLM, running on a PlayStation 4.",
    "description": "Garlic LLM runs Qwen3.5 on the PS4's own GPU. This API speaks the OpenAI Chat Completions protocol, so existing OpenAI client libraries work by changing the base URL to http://<console-address>:8080/v1.\n\nThe API is off until it is turned on with L3 on the console's chat screen, which then shows the address.\n\nOne request runs at a time; a request sent meanwhile waits for it. While the model answers, the console's screen says so and the conversation that was on it is cleared. Circle on the controller stops the reply: the client gets what was written so far, with finish_reason \"length\".\n\nReasoning is always off. Tools are supported (see the tools field): the model may answer with tool_calls, and the results go back as messages with the role \"tool\". Other parameters the console does not implement (for example logprobs, presence_penalty) are ignored. Only n = 1 is supported.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [
    {
      "url": "http://{host}:8080",
      "description": "The console on your network (its address, port 8080)",
      "variables": {
        "host": { "default": "192.168.1.50", "description": "The PS4's IP address" }
      }
    }
  ],
  "tags": [
    { "name": "Chat", "description": "Chat completions" },
    { "name": "Models", "description": "The loaded model" },
    { "name": "System", "description": "Status and this description" }
  ],
  "security": [{ "bearerAuth": [] }, {}],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "tags": ["Chat"],
        "operationId": "createChatCompletion",
        "summary": "Create a chat completion",
        "description": "Generates the assistant's next message from the conversation. With stream: true the reply comes as server-sent events (text/event-stream), one chat.completion.chunk per piece of text, ending with data: [DONE].",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletionRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "The completion, or the event stream when stream is true.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletion" } },
              "text/event-stream": { "schema": { "type": "string", "description": "data: <chat.completion.chunk JSON>, then data: [DONE]" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": ["Models"],
        "operationId": "listModels",
        "summary": "List the model",
        "responses": {
          "200": {
            "description": "The model the console runs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["object", "data"],
                  "properties": {
                    "object": { "type": "string", "const": "list" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Model" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "operationId": "health",
        "summary": "Check that the server is up",
        "security": [],
        "responses": {
          "200": {
            "description": "The server is running.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string", "const": "ok" } } }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["System"],
        "operationId": "openapiDocument",
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": { "description": "This document.", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when the console has an API key (the file /data/garlic_api_key.txt). Without one, no key is needed."
      }
    },
    "responses": {
      "Error": {
        "description": "An error.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["system", "user", "assistant", "tool"]
      },
      "Message": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "$ref": "#/components/schemas/Role" },
          "tool_calls": {
            "type": "array",
            "description": "Assistant messages: the calls the assistant made earlier (as this API returned them).",
            "items": { "$ref": "#/components/schemas/ToolCall" }
          },
          "tool_call_id": { "type": "string", "description": "Tool messages: accepted, not used. The results are matched to the calls by their order." },
          "content": {
            "description": "The text; for a tool message, the result of the call. May be null or missing on an assistant message that has tool_calls.",
            "oneOf": [
              { "type": "null" },
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "text"],
                  "properties": {
                    "type": { "type": "string", "const": "text" },
                    "text": { "type": "string" }
                  }
                }
              }
            ]
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": ["type", "function"],
        "properties": {
          "type": { "type": "string", "const": "function" },
          "function": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parameters": { "type": "object", "description": "A JSON Schema. The type of each property (string, number, boolean...) decides how the model's text for it becomes JSON." }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": ["id", "type", "function"],
        "properties": {
          "id": { "type": "string", "example": "call_1" },
          "type": { "type": "string", "const": "function" },
          "function": {
            "type": "object",
            "required": ["name", "arguments"],
            "properties": {
              "name": { "type": "string" },
              "arguments": { "type": "string", "description": "A JSON object, as text." }
            }
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "model": { "type": "string", "description": "Accepted and ignored: the console runs the one model it has (see GET /v1/models)." },
          "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Message" } },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7, "description": "0 = always the most likely token." },
          "max_tokens": { "type": "integer", "minimum": 1, "maximum": 16384, "default": 512 },
          "max_completion_tokens": { "type": "integer", "minimum": 1, "maximum": 16384, "description": "Same as max_tokens; it wins when both are given." },
          "stream": { "type": "boolean", "default": false },
          "seed": { "type": "integer", "minimum": 0, "description": "Makes the sampling repeatable." },
          "n": { "type": "integer", "const": 1, "default": 1 },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tool" },
            "description": "Functions the model may call. They go in the prompt in Qwen3.5's own format and take context (16K tokens in all): a request that does not fit is refused with context_length_exceeded. Needs a Qwen3.5 model."
          },
          "tool_choice": {
            "description": "\"auto\" (default): the model decides. \"none\": the tools are not given to the model. \"required\" (or a named function): the prompt asks for a call, best effort, which the model may still not follow; the name is not enforced.",
            "oneOf": [
              { "type": "string", "enum": ["auto", "none", "required"] },
              { "type": "object" }
            ]
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
        "properties": {
          "prompt_tokens": { "type": "integer" },
          "completion_tokens": { "type": "integer" },
          "total_tokens": { "type": "integer" }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "required": ["id", "object", "created", "model", "choices", "usage"],
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string", "const": "chat.completion" },
          "created": { "type": "integer" },
          "model": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "message", "finish_reason"],
              "properties": {
                "index": { "type": "integer", "const": 0 },
                "message": {
                  "type": "object",
                  "required": ["role", "content"],
                  "properties": {
                    "role": { "type": "string", "const": "assistant" },
                    "content": { "type": ["string", "null"], "description": "null when the reply is only tool calls." },
                    "tool_calls": { "type": "array", "items": { "$ref": "#/components/schemas/ToolCall" }, "description": "Up to 8 calls, when the model called tools; finish_reason is then \"tool_calls\"." }
                  }
                },
                "finish_reason": { "type": "string", "enum": ["stop", "length", "tool_calls"] }
              }
            }
          },
          "usage": { "$ref": "#/components/schemas/Usage" }
        }
      },
      "ChatCompletionChunk": {
        "type": "object",
        "required": ["id", "object", "created", "model", "choices"],
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string", "const": "chat.completion.chunk" },
          "created": { "type": "integer" },
          "model": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "delta", "finish_reason"],
              "properties": {
                "index": { "type": "integer", "const": 0 },
                "delta": {
                  "type": "object",
                  "properties": {
                    "role": { "type": "string", "const": "assistant" },
                    "content": { "type": "string" },
                    "tool_calls": {
                      "type": "array",
                      "description": "Tool calls come whole in one chunk after the text (the text of a call is held back until it is complete), each with its index.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": { "type": "integer" },
                          "id": { "type": "string" },
                          "type": { "type": "string", "const": "function" },
                          "function": {
                            "type": "object",
                            "properties": { "name": { "type": "string" }, "arguments": { "type": "string" } }
                          }
                        }
                      }
                    }
                  }
                },
                "finish_reason": { "type": ["string", "null"], "enum": ["stop", "length", "tool_calls", null] }
              }
            }
          }
        }
      },
      "Model": {
        "type": "object",
        "required": ["id", "object", "created", "owned_by"],
        "properties": {
          "id": { "type": "string", "example": "Qwen3.5-9B" },
          "object": { "type": "string", "const": "model" },
          "created": { "type": "integer" },
          "owned_by": { "type": "string", "const": "garlic-llm" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message", "type", "code"],
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "enum": ["invalid_request_error", "server_error"] },
              "code": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
